# Copy to terraform.tfvars (gitignored via *.tfvars) and fill in real values. The
# same values as infra/prod/account's for the four that have no default.

# Vercel API token with access to the project.
vercel_api_token = "..."

# Receives the invocation alarm and is the owner's sign-in. Confirm the SNS
# subscription and verify the SES identity from the inbox after the first apply.
alert_email = "you@example.com"

# Google OAuth client (Web application) used by Cognito for Google sign-in. Add
# https://auth.dev.ashutosh-pandey.com/oauth2/idpresponse to its redirect URIs.
google_client_id     = "....apps.googleusercontent.com"
google_client_secret = "..."

# Optional — defaults to true. Set false for the pool's first apply only.
# webauthn_enabled = false
